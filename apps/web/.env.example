# Copy to .env.local and adjust. All values are required; the app refuses to start without them.
# DepositTrack API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Keycloak (infra/docker-compose.yml) and the public client in infra/keycloak/depositrack-realm.json
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=depositrack
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=depositrack-web
