# DEVELOPMENT-ONLY defaults. Copy to infra/.env and change before any shared deployment.

# PostgreSQL
POSTGRES_USER=depositrack
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=depositrack
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# SeaweedFS (S3-compatible object storage)
S3_PORT=8333
S3_ACCESS_KEY=dev-only-access-key
S3_SECRET_KEY=dev-only-secret-key
S3_BUCKET=depositrack-documents

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me

# immudb
IMMUDB_PORT=3322
IMMUDB_ADMIN_PASSWORD=dev-only-change-me
