# DEVELOPMENT-ONLY placeholders for the mock bank (a simulation, not a real bank).
# Copy to services/mock-bank/.env (gitignored) and replace every token before any shared use.

# Token the DepositTrack API presents to the bank: read /keys, /credentials, /status and
# remove AICTE's lien on release (/lien/remove). Must equal DT_BANK_API_TOKEN in apps/api/.env.
MB_API_TOKEN=dev-only-change-me-depositrack-token

# Token of the bank's own operator: the operator page (http://localhost:8090), POST /fdrs,
# GET /ledger and POST /simulate/close. Must differ from MB_API_TOKEN (the mock bank refuses to
# start otherwise) and is never given to DepositTrack. Unset: those endpoints answer 503.
MB_OPERATOR_TOKEN=dev-only-change-me-operator-token

# Fictional bank codes (first four IFSC letters) this mock bank issues FDRs for, comma-separated.
# These are the ones ml/synth uses. GET /keys publishes their keys from the start, so an admin
# can pin them before any FDR is recorded; recording an FDR under another code is refused.
# Leave empty to accept any code; then pin again after the first FDR of each new bank code.
MB_BANK_CODES=XNBK,XSCB,ZDFB,ZPUB,XMRB,ZSCB

# The bank's own state (gitignored under var/).
MB_LEDGER_FILE=var/ledger.json
MB_KEYS_DIR=var/keys

# Hours a signed status confirmation stays fresh before DepositTrack must re-check it (N4).
MB_FRESHNESS_HOURS=24
